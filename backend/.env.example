# Backend Application Configuration
APP_NAME=Space247
PROJECT_NAME="Space247 Real Estate API"
ENVIRONMENT=development
VERSION=0.1.0
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# PostgreSQL Async Database Connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/real_estate_db

# pgvector Embedding Configuration
# Dimension 768 corresponds to multilingual embedding models (e.g., multilingual-e5-base, bge-base)
VECTOR_DIM=768
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-mpnet-base-v2"

# Allowed CORS Origins (JSON array string)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]
